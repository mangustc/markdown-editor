@startuml
interface Attachment as "Вложение" {
    +тип: ТипВложения
    +путьФайловойСистемы: ПутьФайловойСистемы
    +отображаемоеНазвание: Строка
}

enum AttachmentType as "ТипВложения" {
    ФАЙЛ
    ИЗОБРАЖЕНИЕ
}

class PendingAttachment as "ОжидающееВложение" {
}

class ProjectAttachment as "ВложениеПроекта" {
    +относительныйПуть: ОтносительныйПуть
}

class InvalidProjectAttachment as "НевалидноеВложениеПроекта" {
    +относительныйПуть: ОтносительныйПуть
}

class MessageBody as "КраткаяЗаметка" {
    +текст: Строка
    +вложения: Список<Вложение>
    +ссылки: Список<Строка>
    +заметка: Заметка
}

interface TextState as "СостояниеТекста" {
    +текст: CharSequence
    +выделениеТекста: ВыделениеТекста
    +состояниеОтмены: СостояниеОтменыТекста
    +редактировать(блок: ИзменяемоеСостояниеТекста.() -> Unit)
    +установитьТекстИПоместитьКурсорВКонец(текст: Строка)
}

class TextSelection as "ВыделениеТекста" {
    +начало: Число
    +конец: Число
    +свернуто(): Булев
    +мин(): Число
    +макс(): Число
    +длина(): Число
}

interface TextUndoState as "СостояниеОтменыТекста" {
    +можноОтменить: Булев
    +можноПовторить: Булев
    +отменить()
    +повторить()
    +очиститьИсторию()
}

interface MutableTextState as "ИзменяемоеСостояниеТекста" {
    +исходныйТекст: CharSequence
    +выделениеТекста: ВыделениеТекста
    +длина: Число
    +заменить(начало: Число, конец: Число, текст: Строка)
    +вставить(индекс: Число, текст: Строка)
    +добавитьВКонец(текст: Строка)
    +поместитьКурсорПослеСимволаНа(индекс: Число)
}

class FrontMatter as "Метаданные" {
    +поля: Словарь<Строка, ЗначениеМетаданных>
    +созданоВ(): Строка?
    +метки(): Список<Строка>
    +получить(ключ: Строка): ЗначениеМетаданных?
    +вСтрокуМеток(): Строка
    +вСозданоВМиллисекундах(): ДлинноеЧисло?
    +сПолем(ключ: Строка, значение: ЗначениеМетаданных): Метаданные
    +сНовымКлючом(старыйКлюч: Строка, новыйКлюч: Строка): Метаданные
    +сМеткой(метка: Строка): Метаданные
    +безМетки(метка: Строка): Метаданные
    +безПоля(ключ: Строка): Метаданные
    +вСтроку(): Строка
}

interface FrontMatterValue as "ЗначениеМетаданных" {
}

class Scalar as "Скаляр" {
    +значение: Строка
}

class StringList as "СписокСтрок" {
