interface ProjectRepository as "РепозиторийПроекта" {
    +получитьЗаметки(проект: Проект, запрос: ПоисковойЗапрос, включитьТекст: Булев, включитьМетаданные: Булев): Список<Заметка>
    +получитьЗаметкиПостранично(проект: Проект, запрос: ПоисковойЗапрос, включитьТекст: Булев, включитьМетаданные: Булев): Flow<PagingData<Заметка>>
    +получитьЗаметку(проект: Проект, путь: ОтносительныйПуть, включитьТекст: Булев, включитьМетаданные: Булев): Заметка
    +построитьПроект(путьПроекта: ПутьФайловойСистемы): Проект
    +синхронизироватьБазуДанных(проект: Проект)
    +копироватьИзФайловойСистемы(проект: Проект, изПути: ПутьФайловойСистемы, вПутьКаталога: ОтносительныйПуть): ФайлПроекта
    +получитьВсеМетки(проект: Проект): Список<Строка>
    +записатьФайл(проект: Проект, путь: ОтносительныйПуть, байты: ByteArray, стратегия: СтратегияСуществования, создатьРодителей: Булев): ФайлПроекта
    +удалитьФайл(проект: Проект, путь: ОтносительныйПуть)
    +копироватьФайл(проект: Проект, путь: ОтносительныйПуть, новыйПуть: ОтносительныйПуть, стратегия: СтратегияСуществования, создатьРодителей: Булев): ФайлПроекта
    +переместитьФайл(проект: Проект, путь: ОтносительныйПуть, новыйПуть: ОтносительныйПуть, стратегия: СтратегияСуществования, создатьРодителей: Булев): ФайлПроекта
    +прочитатьФайл(проект: Проект, путь: ОтносительныйПуть): ByteArray
    +получитьСписокФайловПроекта(проект: Проект): Список<ФайлПроекта>
    +получитьФайлПроекта(проект: Проект, путь: ОтносительныйПуть): ФайлПроекта
}

