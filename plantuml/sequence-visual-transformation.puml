@startuml
skinparam style strictuml
skinparam sequenceMessageAlign center

actor "Пользователь" as User
participant "EditorScreen:\nUI" as EditorScreen
participant "MarkdownParser:\nMarkdownParser" as Parser
participant "MarkdownOutputTransformation:\nOutputTransformation" as Transform
participant "TextFieldBuffer:\nTextFieldBuffer" as Buffer
participant "MarkdownImageOverlay:\nUI" as Overlay

User -> EditorScreen : Взаимодействие\nс текстом
activate EditorScreen

EditorScreen -> Parser : parse(text)
activate Parser
Parser -> Parser : Анализ текста и\nпоиск токенов
Parser --> EditorScreen : List<SpanInfo>
deactivate Parser

EditorScreen -> Transform : transformOutput(buffer)
activate Transform
activate Buffer

loop Для каждого SpanInfo в списке
    Transform -> Transform : Определение типа токена

    alt SpanInfo.Image
        alt Текст выделен И режим редактирования\n(isSelected && !isViewing)
            Transform -> Buffer : addStyle(Bold + Italic, start, end)
            note right: Отображаем сырой текст\nразметки для редактирования
        else Текст не выделен ИЛИ режим просмотра
            Transform -> Transform : Расчет высоты строки\n(width / aspectRatio)
            Transform -> Buffer : addStyle(ParagraphStyle(lineHeight), start, end)
            Transform -> Buffer : addStyle(Color.Transparent, start, end)
            note right: Резервируем место под\nкартинку и скрываем текст
        end
    else Другие типы (Heading, Bold, Link и т.д.)
        Transform -> Buffer : addStyle(SpanStyle, start, end)
    end
end

alt Режим просмотра включен\n(isViewing == true)
    loop Для каждого типа разметки
        Transform -> Buffer : addStyle(HIDDEN_STYLE, markerStart, markerEnd)
        note right: Делаем маркеры (#, **, [) \nпрозрачными и размер 0.1sp
    end
end
    deactivate Buffer

Transform --> EditorScreen : Трансформированный вывод
deactivate Transform

EditorScreen -> EditorScreen : Вычисление\nTextLayoutResult\n(координаты разметки)

EditorScreen -> Overlay : Отображение AsyncImage в на координатах разметки SpanInfo.Image
activate Overlay
Overlay --> EditorScreen : Success
deactivate Overlay
EditorScreen --> User : Визуальный результат\nна экране

deactivate EditorScreen

@enduml