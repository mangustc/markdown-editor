@startuml

!theme plain

hide empty methods

!procedure $schema($name, $slug)
package "$name" as $slug <<Rectangle>>
!endprocedure

!procedure $table($name, $slug)
entity "<b>$name</b>" as $slug << (T, White) table >>
!endprocedure

!procedure $view($name, $slug)
entity "<b>$name</b>" as $slug << (V, Aquamarine) view >>
!endprocedure

!procedure $pk($name)
<color:#GoldenRod><&key></color> <b>$name</b>
!endprocedure

!procedure $fk($name)
<color:#Silver><&key></color> $name
!endprocedure

!procedure $column($name)
{field} <color:#White><&media-record></color> $name
!endprocedure

$table("ProjectEntity", "t_project") {
  $pk("id"): INTEGER NOT NULL
  $column("name"): TEXT NOT NULL
  $column("rootPath"): TEXT NOT NULL UNIQUE
}

$table("NoteEntity", "t_note") {
  $pk("id"): INTEGER NOT NULL
  $fk("projectId"): INTEGER NOT NULL
  $column("uri"): TEXT NOT NULL UNIQUE
  $column("name"): TEXT NOT NULL
  $column("lastModified"): INTEGER NOT NULL
  $column("createdAt"): INTEGER
  $column("tags"): TEXT NOT NULL
  $column("body"): TEXT NOT NULL
}

$table("NoteEntityFts", "t_note_fts") {
  $fk("rowid"): INTEGER NOT NULL
  $column("name"): TEXT
  $column("body"): TEXT
}

$table("LinkPreviewEntity", "t_link_preview") {
  $pk("url"): TEXT NOT NULL
  $column("title"): TEXT
  $column("description"): TEXT
  $column("imageUrl"): TEXT
  $column("fetchedAt"): INTEGER NOT NULL
}

t_project::id ||-right-o{ t_note::projectId : owns
t_note::id ||-down-|| t_note_fts::rowid : FTS_INDEX
t_project::id ||-[hidden]down-|| t_link_preview::url : FTS_INDEX

@enduml
